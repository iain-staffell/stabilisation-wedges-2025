REM stitch these files together
	dir /b *.tif > list.txt

	gdalwarp                             ^
	  --optfile list.txt                 ^
	  -overwrite                         ^
	  -of GTiff                          ^
	  -co COMPRESS=LZW  -co TILED=YES    ^
	  -co PREDICTOR=2   -co BIGTIFF=YES  ^
	  -srcnodata 0   -dstnodata 0        ^
	  "modis_mosaic.tif"


REM reproject these from sinusoidal to WGS84 at 1/60° resolution
	gdalwarp -s_srs "+proj=sinu +R=6371007.181 +nadgrids=@null +wktext" ^
	  -t_srs EPSG:4326 -tr 0.0166666666 0.0166666666 -tap ^
	  -r mode -co COMPRESS=LZW -co BIGTIFF=YES ^
	  "modis_mosaic.tif" "modis_1m_ext.tif"

REM crop exactly to our common grid
	gdal_translate ^
	  -projwin -180 90  180 -90 ^
	  -co COMPRESS=LZW -co TILED=YES ^
	  "modis_1m_ext.tif"  "modis_1m.tif"

