REM this is the set of GDAL commands to initially process
REM the raw downloads of ESA-CCI-LC and NASA MODIS
REM GDAL on windows is required.  minimal adjustement
REM of commands should be needed to work on unix/mac





REM step 1) process the Koppen-Gieger biome maps
REM         website:  https://www.nature.com/articles/s41597-023-02549-6
REM         download: https://figshare.com/articles/dataset/High-resolution_1_km_K_ppen-Geiger_maps_for_1901_2099_based_on_constrained_CMIP6_projections/21789074/1
REM         legend:   (within the above)

REM navigate to gdal and enable
	SDKShell.bat

REM check your file
	gdalinfo "./1991_2020/koppen_geiger_0p00833333.tif"

REM resample historical biomes to 1/60° resolution
	gdalwarp -t_srs EPSG:4326 -tr 0.0166666666 0.0166666666 -tap ^
	  -r mode -co COMPRESS=LZW -co TILED=YES ^
	  "./1991_2020/koppen_geiger_0p00833333.tif" ^
	  "./1991_2020/koppen_geiger_0p01666666_ext.tif"

REM resample future biomes to 1/60° resolution
	gdalwarp -t_srs EPSG:4326 -tr 0.0166666666 0.0166666666 -tap ^
	  -r mode -co COMPRESS=LZW -co TILED=YES ^
	  "./2041_2070/ssp245/koppen_geiger_0p00833333.tif" ^
	  "./2041_2070/ssp245/koppen_geiger_0p01666666_ext.tif"

REM crop exactly to our common grid
	gdal_translate ^
	  -projwin -180 90  180 -90 -co COMPRESS=LZW -co TILED=YES ^
	  "./1991_2020/koppen_geiger_0p01666666_ext.tif" ^
	  "./1991_2020/koppen_geiger_0p01666666.tif"

REM crop exactly to our common grid
	gdal_translate ^
	  -projwin -180 90  180 -90 -co COMPRESS=LZW -co TILED=YES ^
	  "./2041_2070/ssp245/koppen_geiger_0p01666666_ext.tif" ^
	  "./2041_2070/ssp245/koppen_geiger_0p01666666.tif"





REM step 2) process the ESA-CCI land cover maps
REM         website:  https://maps.elie.ucl.ac.be/CCI/viewer/download.php
REM         download: https://cds.climate.copernicus.eu/cdsapp#!/dataset/satellite-land-cover?tab=overview
REM         legend:   http://maps.elie.ucl.ac.be/CCI/viewer/download/CCI-LC_Maps_Legend.pdf

REM navigate to gdal and enable
	SDKShell.bat

REM check your file
	gdalinfo "C3S-LC-L4-LCCS-Map-300m-P1Y-2022-v2.1.1.nc"

REM convert our desired layer to geotiff
	gdal_translate -of GTiff ^
	  NETCDF:"C3S-LC-L4-LCCS-Map-300m-P1Y-2022-v2.1.1.nc":lccs_class ^
	  "C3S-LC-L4-LCCS-Map-300m-P1Y-2022-v2.1.1.lccs_class.tif"

REM rescale to 1/60° resolution
	gdalwarp -t_srs EPSG:4326 -tr 0.0166666666 0.0166666666 -tap ^
	  -r mode -co COMPRESS=LZW -co TILED=YES ^
	  "C3S-LC-L4-LCCS-Map-300m-P1Y-2022-v2.1.1.lccs_class.tif" ^
	  "cci_2022_1m_ext.tif"

REM crop exactly to our common grid
	gdal_translate ^
	  -projwin -180 90  180 -90 -co COMPRESS=LZW -co TILED=YES ^
	  "cci_2022_1m_ext.tif" ^
	  "cci_2022_1m.tif"





REM step 3) process the NASA MODIS land cover maps
